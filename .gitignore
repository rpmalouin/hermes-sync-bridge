# OS / AppleDouble — this share produces ._ stubs and pathlib globs match them
.DS_Store
._*
.AppleDouble

# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
env/

# Editor / temp
*.swp
*~

# Verification + backup artifacts (the sync tooling writes .bak beside everything it touches)
*.bak
*.orig
*.pre-*
*.deploy-bak

# Queue data must NEVER be committed. The live queue is /Volumes/appdata/hermes-Mac-Updates;
# these names are ignored so a local fixture can never be committed by accident either.
tmp/
new/
processing/
processed/
failed/
Requests/
state/
recent-updates.json

# Local-only config; config/ holds examples
config/local/
config/*.local.*
.env

# Secrets and credential material — nothing here belongs in a public repo
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx
id_rsa*
id_ed25519*
credential*.json
service-account*.json

# Runtime state, logs and analysis artifacts
logs/
reports/
*.log
*.jsonl
*.db
*.db-shm
*.db-wal
*.sqlite*
.pytest_cache/
.code-review-graph/
