# Environment the consumer and the board tools read. Copy to .env or export in the job and edit.
# Secrets never belong in this file — the queue needs no credentials; the SMB mount carries its own.

# --- consumer behaviour -------------------------------------------------------------------
MAILBOX_LEASE_MINUTES=15      # a claim older than this is returned to new/ by the reaper
MAILBOX_MAX_ATTEMPTS=3        # then the message is quarantined in failed/ with a .reason
TMP_MAX_AGE_MIN=60            # sweep in-flight tmp/ files older than this
PROCESSED_KEEP_MONTHS=12      # processed/YYYY-MM retention
DONE_KEEP_DAYS=90             # state/<id>.done retention

# --- the contract -------------------------------------------------------------------------
# Path to the canonical SCHEMA.md. Both hosts read it from the queue; the drift test compares
# shared/protocol.py against it, so point this at the queue, never at a copy.
MAILBOX_SCHEMA=/Volumes/appdata/hermes-Mac-Updates/SCHEMA.md

# --- optional overrides -------------------------------------------------------------------
# VAULT_ROOT=                  # vault root on this host (default /Volumes/Data/vault)
# KANBAN_VAULT=                # the archive roller's vault (falls back to VAULT_ROOT)
# HATCHDOOR_VAULT_ID=          # vault id the board tooling edits — an instance id, no default
# HERMES_TARGET_HOME=          # deploy.sh target (defaults to $HOME); set to rehearse a deploy
# OBSIDIAN_VAULT_PATH=         # not used by this repo; listed here because the board tools run
#                              # from a session that already has it set
